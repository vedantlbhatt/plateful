{
  "expo": {
    "name": "Plateful",
    "slug": "plateful",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.gatech.plateful"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "edu.gatech.plateful"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#E8590C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Plateful uses your photos so you can attach a picture of the leftover food.",
          "cameraPermission": "Plateful uses the camera so you can snap a photo of the leftover food.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "plateful",
    "experiments": {
      "typedRoutes": true
    }
  }
}
