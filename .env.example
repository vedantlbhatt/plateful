# Firebase web app config (Project settings > Your apps > Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Region your functions deploy to (must match functions/src/index.ts)
EXPO_PUBLIC_FUNCTIONS_REGION=us-east1
# Set to your Mac's LAN IP (e.g. 192.168.1.20) to use the Firebase emulators from Expo Go
EXPO_PUBLIC_EMULATOR_HOST=
# EAS project id, required for Expo push tokens (`npx eas-cli@latest init` prints it)
EAS_PROJECT_ID=
